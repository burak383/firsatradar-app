{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native",
      "node"
    ]
  },
  "include": [
    "*.tsx",
    "*.ts"
  ],
  "extends": "expo/tsconfig.base"
}
